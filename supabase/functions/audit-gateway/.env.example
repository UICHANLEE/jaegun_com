# Standalone Deno service. Do not point production clients here until DNS/TLS,
# deployment region, supplier/privacy policy and controlled proxy chain are reviewed.
# Never deploy blindly behind Supabase Edge and assume remoteAddr is the user.
AUDIT_GATEWAY_UPSTREAM=
SUPABASE_ANON_KEY=
AUDIT_GATEWAY_SIGNING_KEY=
AUDIT_GATEWAY_KEY_ID=
# Comma-separated exact RPC names; no wildcard or arbitrary REST/table proxy.
AUDIT_GATEWAY_RPC_ALLOWLIST=
# Operator-owned socket peers that append the true prior hop to X-Forwarded-For.
# Never use 0.0.0.0/0 or ::/0. Missing/untrusted chain means IP unavailable.
AUDIT_GATEWAY_TRUSTED_PROXY_CIDRS=
# Only true for a standalone service whose socket peer IS the client (no reverse proxy).
AUDIT_GATEWAY_DIRECT_CLIENTS=false
AUDIT_GATEWAY_ALLOWED_ORIGINS=
AUDIT_GATEWAY_HOST=127.0.0.1
PORT=8787
# Provision matching key using service-role-only configure_audit_gateway RPC,
# p_enabled=true only after recorded legal approval reference; do not expose key.
# Upstream is an exact fixed HTTPS <project>.supabase.co origin, not client input.
