{
  "name": "jaegun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:dependencies": "npm audit --package-lock-only --audit-level=high && npm --prefix apps/web audit --package-lock-only --audit-level=high",
    "dev:web": "npm run dev --prefix apps/web",
    "build:web": "npm run build --prefix apps/web",
    "test:web": "npm run test --prefix apps/web",
    "typecheck:web": "npm run typecheck --prefix apps/web",
    "security:secrets": "node scripts/security/scan-secrets.mjs",
    "security:legal-docs": "node --experimental-strip-types scripts/security/verify-legal-document-hashes.mjs",
    "lint:migrations": "node scripts/security/lint-sql-migrations.mjs",
    "test:edge-functions": "node --test supabase/functions/request-account-deletion/security.test.mjs supabase/functions/push-security.test.mjs supabase/functions/cleanup-media/security.test.mjs supabase/functions/process-account-deletions/security.test.mjs supabase/functions/dispatch-event-reminders/security.test.mjs",
    "test:security-static": "npm run security:secrets && npm run security:legal-docs && npm run lint:migrations && npm run test:edge-functions",
    "test:realtime-load": "node scripts/ops/realtime-load-test.mjs",
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build:client": "tsc && vite build",
    "build:vercel": "npm run build:web",
    "build": "npm run build:client && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/noto-serif-kr": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
